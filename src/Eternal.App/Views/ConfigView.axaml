<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Eternal.App.ViewModels"
             xmlns:views="using:Eternal.App.Views"
             xmlns:settings="using:Eternal.Core.Settings"
             xmlns:profiles="using:Eternal.Core.Profiles"
             x:Class="Eternal.App.Views.ConfigView"
             x:DataType="vm:ConfigViewModel">

  <UserControl.Styles>
    <Style Selector="Grid.setting">
      <Setter Property="Margin" Value="0,0,0,2" />
    </Style>
    <Style Selector="Grid.setting:disabled">
      <Setter Property="Opacity" Value="0.45" />
    </Style>
    <Style Selector="Button.reset">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="6" />
      <Setter Property="Foreground" Value="{DynamicResource FaintBrush}" />
    </Style>
<Style Selector="Grid.setting > :is(Control).control">
      <Setter Property="Grid.Column" Value="1" />
    </Style>
<Style Selector="views|ConfigView.narrow Grid.setting > views|SettingInfo">
      <Setter Property="Grid.ColumnSpan" Value="2" />
    </Style>
    <Style Selector="views|ConfigView.narrow Grid.setting > :is(Control).control">
      <Setter Property="Grid.Row" Value="1" />
      <Setter Property="Grid.Column" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="Margin" Value="0,10,0,0" />
    </Style>
  </UserControl.Styles>

  <UserControl.DataTemplates>
    <DataTemplate DataType="vm:ToggleRowViewModel">
      <Border Classes="card" Padding="{DynamicResource RowPadding}" Margin="0,0,0,2">
        <Grid Classes="setting" ColumnDefinitions="*,Auto,36" RowDefinitions="Auto,Auto" ColumnSpacing="16" IsEnabled="{Binding IsEnabled}">
          <views:SettingInfo />
          <ToggleSwitch Classes="control" IsChecked="{Binding Value}" OnContent="" OffContent="" MinWidth="0" VerticalAlignment="Center" />
          <Button Grid.Column="2" Classes="reset" Command="{Binding ResetCommand}" IsVisible="{Binding IsTouched}" ToolTip.Tip="Back to TF2's default">
            <PathIcon Data="{StaticResource IconReset}" Width="14" Height="14" />
          </Button>
        </Grid>
      </Border>
    </DataTemplate>
    <DataTemplate DataType="vm:SliderRowViewModel">
      <Border Classes="card" Padding="{DynamicResource RowPadding}" Margin="0,0,0,2">
        <Grid Classes="setting" ColumnDefinitions="*,Auto,36" RowDefinitions="Auto,Auto" ColumnSpacing="16" IsEnabled="{Binding IsEnabled}">
          <views:SettingInfo />
          <Panel Classes="control" VerticalAlignment="Center">
            <NumericUpDown Width="150" Value="{Binding BoxValue}" Minimum="{Binding Minimum}" Maximum="{Binding Maximum}"
                           Increment="{Binding Increment}" FormatString="{Binding FormatString}" IsVisible="{Binding UsesBox}" />
            <StackPanel Orientation="Horizontal" Spacing="12" IsVisible="{Binding !UsesBox}">
              <Slider Width="200" Minimum="{Binding Minimum}" Maximum="{Binding Maximum}" Value="{Binding Value}"
                      SmallChange="{Binding Step}" LargeChange="{Binding Step}" VerticalAlignment="Center" />
              <TextBlock Classes="figure" Width="84" Text="{Binding Display}" VerticalAlignment="Center" TextAlignment="Right" />
            </StackPanel>
          </Panel>
          <Button Grid.Column="2" Classes="reset" Command="{Binding ResetCommand}" IsVisible="{Binding IsTouched}" ToolTip.Tip="Back to TF2's default">
            <PathIcon Data="{StaticResource IconReset}" Width="14" Height="14" />
          </Button>
        </Grid>
      </Border>
    </DataTemplate>
    <DataTemplate DataType="vm:ChoiceRowViewModel">
      <Border Classes="card" Padding="{DynamicResource RowPadding}" Margin="0,0,0,2">
        <Grid Classes="setting" ColumnDefinitions="*,Auto,36" RowDefinitions="Auto,Auto" ColumnSpacing="16" IsEnabled="{Binding IsEnabled}">
          <views:SettingInfo />
          <StackPanel Classes="control" VerticalAlignment="Center" Spacing="4">
            <ComboBox Width="230" ItemsSource="{Binding Options}" SelectedItem="{Binding Selected}">
              <ComboBox.ItemTemplate>
                <DataTemplate DataType="settings:ChoiceOption">
                  <TextBlock Text="{Binding Label}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Classes="meta" Width="230" TextWrapping="Wrap" Text="{Binding Hint}"
                       IsVisible="{Binding Hint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          </StackPanel>
          <Button Grid.Column="2" Classes="reset" Command="{Binding ResetCommand}" IsVisible="{Binding IsTouched}" ToolTip.Tip="Back to TF2's default">
            <PathIcon Data="{StaticResource IconReset}" Width="14" Height="14" />
          </Button>
        </Grid>
      </Border>
    </DataTemplate>
    <DataTemplate DataType="vm:TextRowViewModel">
      <Border Classes="card" Padding="{DynamicResource RowPadding}" Margin="0,0,0,2">
        <Grid Classes="setting" ColumnDefinitions="*,Auto,36" RowDefinitions="Auto,Auto" ColumnSpacing="16" IsEnabled="{Binding IsEnabled}">
          <views:SettingInfo />
          <TextBox Classes="control" Width="230" Text="{Binding Value}" VerticalAlignment="Center" />
          <Button Grid.Column="2" Classes="reset" Command="{Binding ResetCommand}" IsVisible="{Binding IsTouched}" ToolTip.Tip="Back to TF2's default">
            <PathIcon Data="{StaticResource IconReset}" Width="14" Height="14" />
          </Button>
        </Grid>
      </Border>
    </DataTemplate>
  </UserControl.DataTemplates>

  <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="16">

    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="20">
      <StackPanel Spacing="2">
        <TextBlock Classes="display" Text="CONFIG" />
        <TextBlock Classes="muted" Text="{Binding ProfileMatch}" />
      </StackPanel>
      <ToggleSwitch Grid.Column="1" IsChecked="{Binding ShowAdvanced}" OnContent="Show advanced" OffContent="Show advanced"
                    VerticalAlignment="Bottom" ToolTip.Tip="Settings most players never need to change" />
      <TextBox Grid.Column="2" Width="280" Watermark="Search settings or cvars" Text="{Binding Search}" MaxLength="80" VerticalAlignment="Bottom">
        <TextBox.InnerLeftContent>
          <PathIcon Data="{StaticResource IconSearch}" Margin="10,0,0,0" Width="14" Height="14" Foreground="{DynamicResource FaintBrush}" />
        </TextBox.InnerLeftContent>
      </TextBox>
    </Grid>

    <Border Grid.Row="1" Classes="card" Padding="14,10">
      <StackPanel Spacing="6">
        <WrapPanel ItemSpacing="8" LineSpacing="8">
          <TextBlock Classes="meta" Text="Profile" VerticalAlignment="Center" />
          <ComboBox Width="220" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}">
            <ComboBox.ItemTemplate>
              <DataTemplate DataType="profiles:Profile">
                <TextBlock Text="{Binding Name}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <Button Classes="primary" Content="Apply" Command="{Binding ApplyProfileCommand}" />
          <Button Content="Save as new" Command="{Binding SaveAsProfileCommand}" />
          <Button Classes="ghost" Content="Update" Command="{Binding UpdateProfileCommand}" IsEnabled="{Binding CanEditProfile}"
                  ToolTip.Tip="Overwrite the selected profile with your current setup" />
          <Button Classes="ghost" Content="More">
            <Button.Flyout>
              <MenuFlyout>
                <MenuItem Header="Rename" Command="{Binding RenameProfileCommand}" IsEnabled="{Binding CanEditProfile}" />
                <MenuItem Header="Delete" Command="{Binding DeleteProfileCommand}" IsEnabled="{Binding CanEditProfile}" />
              </MenuFlyout>
            </Button.Flyout>
          </Button>
          <Border Width="1" Height="22" Background="{DynamicResource LineBrush}" Margin="4,0" VerticalAlignment="Center" />
          <Button Content="Share" ToolTip.Tip="Your current settings, binds, launch options and mods">
            <Button.Flyout>
              <MenuFlyout>
                <MenuItem Header="Copy a setup code" Command="{Binding CopySetupCodeCommand}" />
                <MenuItem Header="Save as a file, with mods" Command="{Binding SaveSetupFileCommand}" />
              </MenuFlyout>
            </Button.Flyout>
          </Button>
          <Button Classes="ghost" Content="Import">
            <Button.Flyout>
              <MenuFlyout>
                <MenuItem Header="Paste a setup code" Command="{Binding PasteSetupCodeCommand}" />
                <MenuItem Header="Open a setup or profile file" Command="{Binding OpenSetupFileCommand}" />
              </MenuFlyout>
            </Button.Flyout>
          </Button>
        </WrapPanel>
        <TextBlock Classes="meta" TextWrapping="Wrap" Text="{Binding SelectedProfile.Description}"
                   IsVisible="{Binding SelectedProfile.Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      </StackPanel>
    </Border>

    <Grid Grid.Row="2" ColumnDefinitions="210,*" ColumnSpacing="24">
      <ListBox Classes="subnav" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" IsEnabled="{Binding !IsSearching}">
        <ListBox.ItemTemplate>
          <DataTemplate DataType="vm:SettingCategoryViewModel">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
              <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
              <TextBlock Grid.Column="1" Classes="meta figure" Text="{Binding ChangedCount}" ToolTip.Tip="Settings changed by you"
                         IsVisible="{Binding ChangedCount}" />
              <TextBlock Grid.Column="2" Classes="meta figure" Text="{Binding AdvancedHiddenText}" ToolTip.Tip="Shown when Show advanced is on"
                         IsVisible="{Binding AdvancedHiddenText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <Panel Grid.Column="1">
        <ScrollViewer IsVisible="{Binding IsSearching}">
          <StackPanel Margin="0,0,12,12" Spacing="10">
            <TextBlock Classes="heading" Text="{Binding SearchResults.Count, StringFormat='{}{0} MATCHES'}" />
            <ItemsControl ItemsSource="{Binding SearchResults}" />
          </StackPanel>
        </ScrollViewer>

        <ScrollViewer IsVisible="{Binding ShowsSettings}">
          <StackPanel Margin="0,0,12,12" Spacing="12" DataContext="{Binding SelectedCategory}" x:DataType="vm:SettingCategoryViewModel">
            <StackPanel Spacing="2">
              <TextBlock Classes="heading" FontSize="22" Text="{Binding Title}" />
              <TextBlock Classes="muted" Text="{Binding Summary}" TextWrapping="Wrap" />
            </StackPanel>
            <ItemsControl ItemsSource="{Binding VisibleRows}" />
          </StackPanel>
        </ScrollViewer>

        <ScrollViewer IsVisible="{Binding ShowsSounds}">
          <StackPanel Spacing="14" Margin="0,0,12,12" DataContext="{Binding Sounds}" x:DataType="vm:HitKillSoundsViewModel">
            <StackPanel Spacing="2">
              <TextBlock Classes="heading" FontSize="22" Text="Hit &amp; Kill Sounds" />
              <TextBlock Classes="muted" TextWrapping="Wrap" Text="Use any audio file you have. Eternal converts it to the format TF2 reads and packs it as a mod. Add several and TF2 picks one at random each time." />
            </StackPanel>
            <Border Classes="card" Padding="{DynamicResource RowPadding}">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                <StackPanel Spacing="2" VerticalAlignment="Center">
                  <TextBlock Classes="title" Text="Use my sounds" />
                  <TextBlock Classes="muted" FontSize="13" Text="{Binding StatusText}" TextWrapping="Wrap" />
                </StackPanel>
                <ToggleSwitch Grid.Column="1" IsChecked="{Binding Enabled}" OnContent="" OffContent="" MinWidth="0" VerticalAlignment="Center"
                              AutomationProperties.Name="Use my sounds" />
              </Grid>
            </Border>

            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
              <StackPanel Orientation="Horizontal" Spacing="24">
                <Button Classes="tab" Classes.on="{Binding ShowingHit}" Content="{Binding HitTabText}" Command="{Binding ShowHitCommand}" />
                <Button Classes="tab" Classes.on="{Binding ShowingKill}" Content="{Binding KillTabText}" Command="{Binding ShowKillCommand}" />
              </StackPanel>
              <Button Grid.Column="1" Classes="ghost" Content="Add a folder" Command="{Binding AddFolderCommand}" IsEnabled="{Binding !Busy}" VerticalAlignment="Center" />
              <Button Grid.Column="2" Classes="primary" Command="{Binding AddFilesCommand}" IsEnabled="{Binding !Busy}" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <PathIcon Data="{StaticResource IconPlus}" Width="14" Height="14" />
                  <TextBlock Text="Add sounds" />
                </StackPanel>
              </Button>
            </Grid>

            <Border Classes="notice" Background="{DynamicResource SurfaceBrush}" IsVisible="{Binding Busy}">
              <StackPanel Spacing="6">
                <TextBlock Text="{Binding BusyText}" TextTrimming="CharacterEllipsis" />
                <ProgressBar Classes="thin" Value="{Binding BusyProgress}" Maximum="100" />
              </StackPanel>
            </Border>

            <Border Classes="card" IsVisible="{Binding IsEmpty}">
              <StackPanel Spacing="6">
                <TextBlock Classes="title" Text="{Binding EmptyTitle}" />
                <TextBlock Classes="muted" TextWrapping="Wrap" Text="Press Add sounds, or drop files anywhere on this window. WAV, MP3, FLAC, OGG, Opus, M4A and the audio track of videos all work." />
              </StackPanel>
            </Border>

            <TextBlock Classes="meta" Text="{Binding ListNote}" IsVisible="{Binding !IsEmpty}" />
            <ItemsRepeater ItemsSource="{Binding Shown}">
              <ItemsRepeater.Layout>
                <StackLayout Spacing="2" />
              </ItemsRepeater.Layout>
              <ItemsRepeater.ItemTemplate>
                <DataTemplate DataType="vm:SoundRowViewModel">
                  <Border Classes="card" Padding="10,6,12,6">
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto" ColumnSpacing="10">
                      <Button Classes="ghost" Padding="8" VerticalAlignment="Center" ToolTip.Tip="Listen" AutomationProperties.Name="Listen"
                              Command="{Binding $parent[UserControl].((vm:ConfigViewModel)DataContext).Sounds.PlayCommand}" CommandParameter="{Binding}">
                        <Panel>
                          <PathIcon Data="{StaticResource IconPlay}" Width="14" Height="14" IsVisible="{Binding !Playing}" />
                          <PathIcon Data="{StaticResource IconClose}" Width="14" Height="14" IsVisible="{Binding Playing}" />
                        </Panel>
                      </Button>
                      <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                        <TextBlock FontWeight="SemiBold" Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" />
                        <TextBlock Classes="meta" Text="{Binding Length}" />
                      </StackPanel>
                      <Slider Grid.Column="2" Width="130" Minimum="10" Maximum="200" Value="{Binding Volume}" VerticalAlignment="Center"
                              ToolTip.Tip="Volume of this sound" AutomationProperties.Name="Volume" />
                      <TextBlock Grid.Column="3" Classes="meta figure" Width="38" Text="{Binding VolumeText}" VerticalAlignment="Center" TextAlignment="Right" />
                      <ToggleSwitch Grid.Column="4" IsChecked="{Binding Enabled}" OnContent="" OffContent="" MinWidth="0" VerticalAlignment="Center"
                                    ToolTip.Tip="Include this sound" AutomationProperties.Name="Include this sound" />
                      <Button Grid.Column="5" Classes="ghost" Padding="8" VerticalAlignment="Center" ToolTip.Tip="Remove" AutomationProperties.Name="Remove"
                              Command="{Binding $parent[UserControl].((vm:ConfigViewModel)DataContext).Sounds.RemoveCommand}" CommandParameter="{Binding}">
                        <PathIcon Data="{StaticResource IconTrash}" Width="14" Height="14" />
                      </Button>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
              <TextBlock Classes="meta" TextWrapping="Wrap" Text="{Binding LimitNote}" VerticalAlignment="Center" />
              <Button Grid.Column="1" Classes="link danger" Content="Remove all" Command="{Binding RemoveAllCommand}" IsVisible="{Binding !IsEmpty}" />
            </Grid>
          </StackPanel>
        </ScrollViewer>

        <ScrollViewer IsVisible="{Binding ShowsBinds}">
          <StackPanel Margin="0,0,12,12" Spacing="12">
            <StackPanel Spacing="2">
              <TextBlock Classes="heading" FontSize="22" Text="Binds" />
              <TextBlock Classes="muted" TextWrapping="Wrap" Text="Click the key button, then press a key, mouse button or scroll. Commands can't contain double quotes; use an alias in your own autoexec for anything that needs them." />
            </StackPanel>
            <ItemsControl ItemsSource="{Binding Binds}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="vm:BindRowViewModel">
                  <Border Classes="card" Padding="12,10" Margin="0,0,0,2">
                    <Grid ColumnDefinitions="130,180,*,Auto,Auto" ColumnSpacing="10">
                      <Button Content="{Binding KeyText}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                              Command="{Binding $parent[UserControl].((vm:ConfigViewModel)DataContext).CaptureKeyCommand}" CommandParameter="{Binding}"
                              Classes.primary="{Binding Capturing}" />
                      <TextBox Grid.Column="1" Watermark="Label (optional)" Text="{Binding Label}" />
                      <TextBox Grid.Column="2" Watermark="Command, e.g. voicemenu 0 0" Text="{Binding Command}" />
                      <PathIcon Grid.Column="3" Data="{StaticResource IconWarning}" Foreground="{DynamicResource WarningBrush}"
                                IsVisible="{Binding !IsValid}" ToolTip.Tip="This bind is incomplete or contains a double quote, so it isn't written." />
                      <Button Grid.Column="4" Classes="ghost" ToolTip.Tip="Remove bind"
                              Command="{Binding $parent[UserControl].((vm:ConfigViewModel)DataContext).RemoveBindCommand}" CommandParameter="{Binding}">
                        <PathIcon Data="{StaticResource IconTrash}" Width="14" Height="14" />
                      </Button>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button HorizontalAlignment="Left" Command="{Binding AddBindCommand}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <PathIcon Data="{StaticResource IconPlus}" Width="14" Height="14" />
                <TextBlock Text="Add bind" />
              </StackPanel>
            </Button>
          </StackPanel>
        </ScrollViewer>

        <ScrollViewer IsVisible="{Binding ShowsLaunch}">
          <StackPanel Margin="0,0,12,12" Spacing="16">
            <StackPanel Spacing="2">
              <TextBlock Classes="heading" FontSize="22" Text="Launch Options" />
              <TextBlock Classes="muted" TextWrapping="Wrap" Text="Anything extra you want TF2 to start with, such as -console. Resolution, window mode and the other launch settings live in their own sections." />
            </StackPanel>
            <StackPanel Spacing="6">
              <TextBox Text="{Binding ExtraArgs}" Watermark="-console +map cp_badlands" />
              <TextBlock Classes="warning" FontSize="13" TextWrapping="Wrap" Text="{Binding ExtraArgsProblem}"
                         IsVisible="{Binding ExtraArgsProblem, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            </StackPanel>
            <Border Classes="card">
              <StackPanel Spacing="10">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Classes="title" Text="TF2 starts with" VerticalAlignment="Center" />
                  <Button Grid.Column="1" Classes="ghost" Command="{Binding CopyLaunchLineCommand}" ToolTip.Tip="Copy">
                    <PathIcon Data="{StaticResource IconCopy}" Width="14" Height="14" />
                  </Button>
                </Grid>
                <SelectableTextBlock FontFamily="monospace" FontSize="13" Text="{Binding LaunchLine}" TextWrapping="Wrap" />
                <TextBlock Classes="meta" TextWrapping="Wrap"
                           Text="+exec w/config.cfg is added while mods are applied; it runs the preloader's setup when TF2 boots. If you start TF2 from Steam instead of here, copy this line into TF2's launch options in Steam." />
              </StackPanel>
            </Border>
            <StackPanel Spacing="8">
              <ToggleSwitch IsChecked="{Binding ShowPreview}" OnContent="Show what goes into autoexec.cfg" OffContent="Show what goes into autoexec.cfg" />
              <Border Classes="card" IsVisible="{Binding ShowPreview}">
                <StackPanel Spacing="8">
                  <TextBlock Classes="meta" Text="{Binding AutoexecPath}" />
                  <SelectableTextBlock FontFamily="monospace" FontSize="12" Text="{Binding AutoexecPreview}" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="Read my autoexec.cfg again" Command="{Binding ImportAutoexecCommand}" />
              <Button Classes="ghost" Content="Open cfg folder" Command="{Binding OpenCfgFolderCommand}" />
              <Button Classes="ghost danger" Content="Reset every setting" Command="{Binding ResetAllCommand}" />
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Panel>
    </Grid>

    <Grid Grid.Row="3" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
      <PathIcon Data="{StaticResource IconWarning}" Width="14" Height="14" Foreground="{DynamicResource DangerBrush}" IsVisible="{Binding SaveProblem}" />
      <TextBlock Grid.Column="1" Classes="meta" Text="{Binding SaveStatus}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                 Classes.danger="{Binding SaveProblem}" />
      <Button Grid.Column="2" Classes="link" Content="Retry" Command="{Binding RetrySaveCommand}" IsVisible="{Binding SaveProblem}" />
    </Grid>
  </Grid>
</UserControl>
