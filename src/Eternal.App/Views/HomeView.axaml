<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Eternal.App.ViewModels"
             xmlns:views="using:Eternal.App.Views"
             x:Class="Eternal.App.Views.HomeView"
             x:DataType="vm:HomeViewModel">

  <Grid ColumnDefinitions="*,340" ColumnSpacing="28">

    <ScrollViewer Grid.Column="0">
      <StackPanel Margin="0,0,12,12" Spacing="{DynamicResource SectionGap}">
        <StackPanel Spacing="2">
          <TextBlock Classes="display" Text="HOME" />
          <TextBlock Classes="muted" Text="{Binding Greeting}" />
        </StackPanel>

        <StackPanel Spacing="12" IsVisible="{Binding ShowsMods}">
          <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
            <TextBlock Classes="heading" Text="FRESH ON GAMEBANANA" VerticalAlignment="Center" />
            <Button Grid.Column="1" Classes="link" Content="Browse all" Command="{Binding BrowseAllCommand}" VerticalAlignment="Center" />
            <Button Grid.Column="2" Classes="ghost" Command="{Binding RefreshCommand}" ToolTip.Tip="Refresh">
              <PathIcon Data="{StaticResource IconRefresh}" />
            </Button>
          </Grid>
          <TextBlock Classes="muted" Text="{Binding ModsError}" IsVisible="{Binding ModsError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          <ProgressBar Classes="thin" IsIndeterminate="{Binding LoadingMods}" IsVisible="{Binding LoadingMods}" />
          <ItemsRepeater ItemsSource="{Binding FreshMods}">
            <ItemsRepeater.Layout>
              <UniformGridLayout MinItemWidth="168" MinRowSpacing="12" MinColumnSpacing="12" ItemsStretch="Fill" />
            </ItemsRepeater.Layout>
            <ItemsRepeater.ItemTemplate>
              <DataTemplate DataType="vm:SubmissionCard">
                <Button Classes="ghost" Padding="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                        ToolTip.Tip="{Binding Name}" AutomationProperties.Name="{Binding Name}"
                        Command="{Binding $parent[UserControl].((vm:HomeViewModel)DataContext).OpenModCommand}" CommandParameter="{Binding}">
                  <Border Classes="card" Padding="0" ClipToBounds="True">
                    <StackPanel>
                      <Panel Background="{DynamicResource RaisedBrush}" Height="104" ClipToBounds="True">
                        <Image Stretch="UniformToFill" views:RemoteImage.DecodeWidth="420" views:RemoteImage.Url="{Binding Thumbnail}" />
                        <Border Classes="badge installed" IsVisible="{Binding Installed}" Margin="8" HorizontalAlignment="Left" VerticalAlignment="Top">
                          <TextBlock Text="Installed" />
                        </Border>
                      </Panel>
                      <StackPanel Margin="12,10,12,12" Spacing="2">
                        <TextBlock Classes="title" Text="{Binding Name}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource InkBrush}" />
                        <TextBlock Classes="meta" Text="{Binding Author}" TextTrimming="CharacterEllipsis" FontWeight="Normal" />
                        <TextBlock Classes="meta" Text="{Binding Category}" TextTrimming="CharacterEllipsis" FontWeight="Normal" />
                      </StackPanel>
                    </StackPanel>
                  </Border>
                </Button>
              </DataTemplate>
            </ItemsRepeater.ItemTemplate>
          </ItemsRepeater>
        </StackPanel>

        <StackPanel Spacing="12" IsVisible="{Binding ShowsNews}">
          <TextBlock Classes="heading" Text="{Binding NewsHeading}" />
          <TextBlock Classes="muted" Text="{Binding NewsError}" IsVisible="{Binding NewsError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          <ProgressBar Classes="thin" IsIndeterminate="{Binding LoadingNews}" IsVisible="{Binding LoadingNews}" />
          <ItemsControl ItemsSource="{Binding News}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="vm:NewsRow">
                <Button Classes="ghost" Padding="0" Margin="0,0,0,8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                        Command="{Binding $parent[UserControl].((vm:HomeViewModel)DataContext).OpenNewsCommand}" CommandParameter="{Binding}">
                  <Border Classes="card" Padding="16">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                      <Border Width="176" Height="99" Background="{DynamicResource RaisedBrush}" ClipToBounds="True" CornerRadius="2">
                        <Image Stretch="UniformToFill" views:RemoteImage.DecodeWidth="360" views:RemoteImage.Url="{Binding ImageUrl}" />
                      </Border>
                      <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                        <TextBlock Classes="title" FontSize="16" Text="{Binding Title}" TextWrapping="Wrap" Foreground="{DynamicResource InkBrush}" />
                        <TextBlock Classes="muted" Text="{Binding Summary}" TextWrapping="Wrap" MaxLines="3" TextTrimming="WordEllipsis" FontWeight="Normal" />
                        <TextBlock Classes="meta" Text="{Binding When}" FontWeight="Normal" IsVisible="{Binding !IsGroup}" />
                        <ItemsControl ItemsSource="{Binding Posts}" IsVisible="{Binding IsGroup}" Margin="0,2,0,0">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel ItemSpacing="12" LineSpacing="2" /></ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:NewsPostRow">
                              <Button Classes="link" FontSize="12" Content="{Binding Date}" ToolTip.Tip="Open this update's notes"
                                      Command="{Binding $parent[UserControl].((vm:HomeViewModel)DataContext).OpenPostCommand}" CommandParameter="{Binding}" />
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </Grid>
                  </Border>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>

    <ScrollViewer Grid.Column="1" Margin="0,62,0,0">
    <StackPanel Margin="0,0,12,12" Spacing="16">
      <Border Classes="card">
        <StackPanel Spacing="10">
          <TextBlock Classes="heading" Text="LOADOUT" />
          <StackPanel Spacing="2">
            <TextBlock Classes="title" Text="{Binding Main.DockTitle}" />
            <TextBlock Classes="meta" Text="{Binding Main.DockDetail}" TextWrapping="Wrap" />
          </StackPanel>
          <StackPanel Spacing="2" IsVisible="{Binding ShowsConfig}">
            <TextBlock Classes="meta" Text="Config" />
            <TextBlock Text="{Binding Main.Config.ProfileMatch}" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Manage mods" Command="{Binding GoCommand}" CommandParameter="mods" IsVisible="{Binding ShowsManageMods}" />
            <Button Classes="ghost" Content="Config" Command="{Binding GoCommand}" CommandParameter="config" IsVisible="{Binding ShowsConfig}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Classes="card" IsVisible="{Binding ShowsBackpack}">
        <StackPanel Spacing="10">
          <TextBlock Classes="heading" Text="BACKPACK" />
          <StackPanel Spacing="2">
            <TextBlock Classes="figure accent" FontSize="26" Text="{Binding Main.Backpack.Total}" IsVisible="{Binding Main.Backpack.HasItems}" />
            <TextBlock Classes="meta" Text="{Binding Main.Backpack.Coverage}" TextWrapping="Wrap"
                       IsVisible="{Binding Main.Backpack.Coverage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <TextBlock Classes="meta" Text="Open the backpack to price your items."
                       IsVisible="{Binding !Main.Backpack.HasItems}" />
          </StackPanel>
          <Button Content="Open backpack" Command="{Binding GoCommand}" CommandParameter="backpack" />
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="8">
          <TextBlock Classes="heading" Text="GAME" />
          <StackPanel Spacing="2">
            <TextBlock Classes="meta" Text="{Binding FolderLabel}" />
            <TextBlock Text="{Binding Tf2Folder}" TextWrapping="Wrap" FontSize="13" />
            <TextBlock Classes="danger" FontSize="12" Text="{Binding FolderProblem}" IsVisible="{Binding !Tf2Found}" />
          </StackPanel>
          <StackPanel Spacing="2" IsVisible="{Binding Account, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <TextBlock Classes="meta" Text="Steam account" />
            <TextBlock Text="{Binding Account}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
