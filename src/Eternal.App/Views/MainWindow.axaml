<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Eternal.App.ViewModels"
        xmlns:views="using:Eternal.App.Views"
        x:Class="Eternal.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Eternal TF2 Launcher"
        Icon="{Binding Theme.Icon}"
        Width="1300" Height="800" MinWidth="1040" MinHeight="660"
        WindowStartupLocation="CenterScreen"
        DragDrop.AllowDrop="True">

  <Window.DataTemplates>
    <DataTemplate DataType="vm:HomeViewModel"><views:HomeView /></DataTemplate>
    <DataTemplate DataType="vm:ServersViewModel"><views:ServersView /></DataTemplate>
    <DataTemplate DataType="vm:ScreenshotsViewModel"><views:ScreenshotsView /></DataTemplate>
    <DataTemplate DataType="vm:ModsViewModel"><views:ModsView /></DataTemplate>
    <DataTemplate DataType="vm:BackpackViewModel"><views:BackpackView /></DataTemplate>
    <DataTemplate DataType="vm:ConfigViewModel"><views:ConfigView /></DataTemplate>
    <DataTemplate DataType="vm:LauncherViewModel"><views:LauncherView /></DataTemplate>
  </Window.DataTemplates>

  <Panel>
    <Image Source="{Binding Theme.Background}" Stretch="UniformToFill"
           IsVisible="{Binding Theme.Background, Converter={x:Static ObjectConverters.IsNotNull}}" />
    <Rectangle Fill="{DynamicResource ScrimBrush}"
               IsVisible="{Binding Theme.Background, Converter={x:Static ObjectConverters.IsNotNull}}" />

    <LayoutTransformControl Name="Zoom">

      <Panel>
        <Grid RowDefinitions="*,Auto" ColumnDefinitions="236,*">

          <DockPanel Grid.Row="0" Grid.Column="0" LastChildFill="True">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="12" Margin="24,26,16,34">
              <Image Source="{Binding Theme.Logo}" Width="40" Height="40" RenderOptions.BitmapInterpolationMode="HighQuality" />
              <StackPanel VerticalAlignment="Center" Spacing="-4">
                <TextBlock Classes="display" FontSize="27" Text="ETERNAL" />
                <TextBlock Classes="meta" Text="TF2 Launcher" />
              </StackPanel>
            </StackPanel>

            <StackPanel DockPanel.Dock="Bottom" Margin="28,0,16,20" Spacing="6">
              <Button Classes="link" Command="{Binding Updates.ShowCardCommand}" IsVisible="{Binding Updates.HasNews}"
                      ToolTip.Tip="{Binding Updates.CardTitle}" AutomationProperties.Name="{Binding Updates.CardTitle}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Ellipse Width="7" Height="7" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                  <TextBlock Classes="accent" FontWeight="SemiBold" Text="{Binding Updates.SidebarText}" />
                </StackPanel>
              </Button>
              <StackPanel Orientation="Horizontal" Spacing="2" Margin="-6,0,0,0">
                <Button Classes="social" Command="{Binding OpenDiscordCommand}" ToolTip.Tip="Discord" AutomationProperties.Name="Discord">
                  <PathIcon Data="{StaticResource IconDiscord}" Width="18" Height="18" />
                </Button>
                <Button Classes="social" Command="{Binding OpenWebsiteCommand}" ToolTip.Tip="Website" AutomationProperties.Name="Website">
                  <PathIcon Data="{StaticResource IconWebsite}" Width="18" Height="18" />
                </Button>
                <Button Classes="social" Command="{Binding OpenGitHubCommand}" ToolTip.Tip="GitHub" AutomationProperties.Name="GitHub">
                  <PathIcon Data="{StaticResource IconGitHub}" Width="18" Height="18" />
                </Button>
              </StackPanel>
              <TextBlock Classes="meta" Text="{Binding Version, StringFormat='v{0}'}" />
            </StackPanel>

            <ListBox Classes="nav" ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab}"
                     AutoScrollToSelectedItem="False">
              <ListBox.ItemTemplate>
                <DataTemplate DataType="vm:TabViewModel">
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                    <Ellipse Width="7" Height="7" Fill="{DynamicResource WarningBrush}" VerticalAlignment="Center"
                             IsVisible="{Binding HasAlert}" ToolTip.Tip="Mods need attention" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>

          <ContentControl Grid.Row="0" Grid.Column="1" Classes="page" Margin="8,24,32,0"
                          Content="{Binding SelectedTab.Page}" />

          <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Background="{DynamicResource SurfaceBrush}" Margin="0,20,0,0">
            <Grid ColumnDefinitions="236,*,Auto,Auto" Height="92">
              <ProgressBar Grid.ColumnSpan="4" Classes="thin" VerticalAlignment="Top"
                           IsVisible="{Binding DockBusy}" Value="{Binding DockProgress}" Maximum="100"
                           IsIndeterminate="{Binding DockIndeterminate}" />
              <StackPanel Grid.Column="0" Margin="28,0,0,0" VerticalAlignment="Center" Spacing="2">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <PathIcon Data="{StaticResource IconWarning}" Width="14" Height="14" Foreground="{DynamicResource WarningBrush}"
                            IsVisible="{Binding DockProblem}" />
                  <TextBlock Classes="title" Text="{Binding DockTitle}" />
                </StackPanel>
                <TextBlock Classes="meta" Text="{Binding DockDetail}" TextTrimming="CharacterEllipsis" MaxWidth="200"
                           ToolTip.Tip="{Binding DockDetail}" />
              </StackPanel>
              <StackPanel Grid.Column="1" Margin="8,0,24,0" VerticalAlignment="Center" Spacing="2">
                <TextBlock Classes="meta" Text="Launches with" />
                <TextBlock Classes="muted" Text="{Binding LaunchSummary}" TextTrimming="CharacterEllipsis" />
              </StackPanel>
              <Button Grid.Column="2" Classes="link" Margin="0,0,20,0" VerticalAlignment="Center" Content="Cancel"
                      Command="{Binding CancelLaunchCommand}"
                      IsVisible="{Binding PlayState, Converter={x:Static views:Converters.IsPreparing}}" />
              <Button Grid.Column="3" Classes="play" Margin="0,0,32,0" VerticalAlignment="Center"
                      Command="{Binding PlayCommand}" IsEnabled="{Binding CanPlay}"
                      Content="{Binding PlayLabel}" HotKey="Ctrl+Enter" />
            </Grid>
          </Border>

          <StackPanel Grid.Row="0" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,32,12"
                      Width="420" Spacing="8">
            <Border Classes="toast" DataContext="{Binding Updates}" IsVisible="{Binding CardOpen}" views:Hold.WhileUsed="True"
                    Padding="16,14">
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                <Border Width="3" Background="{DynamicResource AccentBrush}" CornerRadius="1" />
                <StackPanel Grid.Column="1" Spacing="8">
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <Image Source="{Binding $parent[Window].((vm:MainViewModel)DataContext).Theme.Logo}" Width="22" Height="22"
                           RenderOptions.BitmapInterpolationMode="HighQuality" />
                    <TextBlock Grid.Column="1" Classes="title" Text="{Binding CardTitle}" VerticalAlignment="Center" TextWrapping="Wrap" />
                  </Grid>
                  <TextBlock Classes="muted" FontSize="13" Text="{Binding CardText}" TextWrapping="Wrap" />
                  <TextBlock FontSize="13" Text="{Binding Notes}" TextWrapping="Wrap" MaxLines="3" TextTrimming="WordEllipsis"
                             IsVisible="{Binding HasNotes}" />
                  <StackPanel Spacing="4" IsVisible="{Binding IsDownloading}">
                    <ProgressBar Classes="thin" Value="{Binding Progress}" Maximum="1" />
                    <TextBlock Classes="meta figure" Text="{Binding ProgressText}" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="14" Margin="0,2,0,0">
                    <Button Classes="primary" Content="Restart now" Command="{Binding RestartNowCommand}" IsVisible="{Binding IsReady}" />
                    <Button Classes="primary" Content="{Binding ActionLabel}" Command="{Binding DownloadCommand}" IsVisible="{Binding IsAvailable}" />
                    <Button Classes="link" Content="What's new" Command="{Binding OpenPageCommand}" VerticalAlignment="Center" />
                  </StackPanel>
                </StackPanel>
                <Button Grid.Column="2" Classes="ghost" Padding="4" VerticalAlignment="Top" Command="{Binding LaterCommand}"
                        ToolTip.Tip="Later" AutomationProperties.Name="Later">
                  <PathIcon Data="{StaticResource IconClose}" Width="12" Height="12" />
                </Button>
              </Grid>
            </Border>

            <ItemsControl ItemsSource="{Binding Notices}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Spacing="8" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="vm:NoticeViewModel">
                  <Border Classes="toast" Padding="16,12" views:Hold.WhileUsed="True">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                      <Border Width="3" Background="{DynamicResource AccentBrush}" CornerRadius="1"
                              IsVisible="{Binding !IsError}" />
                      <Border Width="3" Background="{DynamicResource DangerBrush}" CornerRadius="1"
                              IsVisible="{Binding IsError}" />
                      <TextBlock Grid.Column="1" Text="{Binding Message}" TextWrapping="Wrap" />
                      <Button Grid.Column="2" Classes="ghost" Padding="4" VerticalAlignment="Top" Command="{Binding DismissCommand}"
                              ToolTip.Tip="Dismiss" AutomationProperties.Name="Dismiss">
                        <PathIcon Data="{StaticResource IconClose}" Width="12" Height="12" />
                      </Button>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Grid>

        <Border Name="DropOverlay" Background="{DynamicResource ScrimBrush}" IsVisible="False">
          <Border Background="{DynamicResource SurfaceBrush}" Padding="40,32" CornerRadius="3"
                  HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel Spacing="6" HorizontalAlignment="Center">
              <TextBlock Classes="display" Text="DROP TO IMPORT" HorizontalAlignment="Center" />
              <TextBlock Classes="muted" Text="VPK, ZIP, RAR, 7z or folders" HorizontalAlignment="Center" />
            </StackPanel>
          </Border>
        </Border>

        <Border Background="#99000000" IsVisible="{Binding ImportChoice, Converter={x:Static ObjectConverters.IsNotNull}}"
                KeyboardNavigation.TabNavigation="Cycle">
          <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="4" Padding="28,24" Width="560" MaxHeight="560"
                  HorizontalAlignment="Center" VerticalAlignment="Center" BoxShadow="0 16 48 0 #88000000">
            <DockPanel DataContext="{Binding ImportChoice}" x:DataType="vm:ImportChoiceViewModel">
              <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,14">
                <TextBlock Classes="heading" FontSize="22" Text="{Binding Title}" TextWrapping="Wrap" />
                <TextBlock Classes="muted" Text="{Binding Message}" TextWrapping="Wrap" />
              </StackPanel>
              <Grid DockPanel.Dock="Bottom" ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="10" Margin="0,16,0,0">
                <Button Classes="link" Content="Pick all" Command="{Binding PickAllCommand}" VerticalAlignment="Center" />
                <Button Grid.Column="1" Classes="link" Content="Pick none" Command="{Binding PickNoneCommand}" VerticalAlignment="Center" />
                <Button Grid.Column="3" Classes="ghost" Content="Cancel" Command="{Binding CancelCommand}" IsCancel="True" />
                <Button Grid.Column="4" Name="ChoiceInstall" Classes="primary" Content="Install" Command="{Binding InstallCommand}"
                        IsEnabled="{Binding CanInstall}" IsDefault="True" />
              </Grid>
              <ScrollViewer>
                <ItemsControl ItemsSource="{Binding Parts}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:PartChoice">
                      <Border Background="{DynamicResource RaisedBrush}" CornerRadius="3" Padding="12,9" Margin="0,0,0,4">
                        <CheckBox IsChecked="{Binding Picked}" AutomationProperties.Name="{Binding Name}">
                          <StackPanel Spacing="2" Margin="4,0,0,0">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Classes="meta" Text="{Binding Detail}" />
                            <TextBlock Classes="meta" TextWrapping="Wrap" IsVisible="{Binding HasAlternatives}"
                                       Text="{Binding Alternatives, StringFormat='Changes the same files as {0}'}" />
                          </StackPanel>
                        </CheckBox>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </DockPanel>
          </Border>
        </Border>

        <Border Background="#99000000" IsVisible="{Binding FolderReview, Converter={x:Static ObjectConverters.IsNotNull}}"
                KeyboardNavigation.TabNavigation="Cycle">
          <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="4" Padding="28,24" Width="680" MaxHeight="600"
                  HorizontalAlignment="Center" VerticalAlignment="Center" BoxShadow="0 16 48 0 #88000000">
            <DockPanel DataContext="{Binding FolderReview}" x:DataType="vm:GameFolderReviewViewModel">
              <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,14">
                <TextBlock Classes="heading" FontSize="24" Text="Before anything changes" />
                <TextBlock Classes="muted" Text="{Binding Message}" TextWrapping="Wrap" />
              </StackPanel>
              <StackPanel DockPanel.Dock="Bottom" Spacing="14" Margin="0,16,0,0">
                <StackPanel Spacing="4">
                  <CheckBox IsChecked="{Binding ManageAutoexec}" Content="Let Eternal add its own block to autoexec.cfg when I change a setting" />
                  <CheckBox IsChecked="{Binding ReadAutoexec}" Content="Show the values from my autoexec.cfg in the Config tab" IsVisible="{Binding HasAutoexec}" />
                  <TextBlock Classes="meta" TextWrapping="Wrap" Text="Move into Eternal adds a mod to your list so it loads in Casual too. Put aside moves it to a backup you can open from the Launcher tab. Nothing gets deleted." />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                  <Button Name="ReviewApply" Classes="ghost" Content="Apply my choices" Command="{Binding ApplyCommand}" IsEnabled="{Binding AnyChanged}" />
                  <Button Name="ReviewKeep" Classes="primary" Content="Keep everything" Command="{Binding KeepEverythingCommand}" IsDefault="True" />
                </StackPanel>
              </StackPanel>
              <ScrollViewer>
                <StackPanel Spacing="14" Margin="0,0,12,0">
                  <StackPanel Spacing="4" IsVisible="{Binding HasMods}">
                    <TextBlock Classes="meta" Text="In tf/custom" Margin="0,0,0,2" />
                    <ItemsControl ItemsSource="{Binding Mods}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:FoundRowViewModel">
                          <Border Classes="raised" Padding="12,8" Margin="0,0,0,4">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                              <StackPanel Spacing="1" VerticalAlignment="Center">
                                <TextBlock FontWeight="SemiBold" Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" />
                                <TextBlock Classes="meta" Text="{Binding Detail}" TextTrimming="CharacterEllipsis" />
                              </StackPanel>
                              <ComboBox Grid.Column="1" Width="170" ItemsSource="{Binding Choices}" SelectedItem="{Binding Choice}"
                                        AutomationProperties.Name="{Binding Name}">
                                <ComboBox.ItemTemplate>
                                  <DataTemplate DataType="vm:FoundChoice"><TextBlock Text="{Binding Label}" /></DataTemplate>
                                </ComboBox.ItemTemplate>
                              </ComboBox>
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                  <StackPanel Spacing="4" IsVisible="{Binding HasConfigs}">
                    <TextBlock Classes="meta" Text="In tf/cfg" Margin="0,0,0,2" />
                    <ItemsControl ItemsSource="{Binding Configs}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:FoundRowViewModel">
                          <Border Classes="raised" Padding="12,8" Margin="0,0,0,4">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                              <StackPanel Spacing="1" VerticalAlignment="Center">
                                <TextBlock FontWeight="SemiBold" Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" />
                                <TextBlock Classes="meta" Text="{Binding Detail}" TextTrimming="CharacterEllipsis" />
                              </StackPanel>
                              <ComboBox Grid.Column="1" Width="170" ItemsSource="{Binding Choices}" SelectedItem="{Binding Choice}"
                                        AutomationProperties.Name="{Binding Name}">
                                <ComboBox.ItemTemplate>
                                  <DataTemplate DataType="vm:FoundChoice"><TextBlock Text="{Binding Label}" /></DataTemplate>
                                </ComboBox.ItemTemplate>
                              </ComboBox>
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </StackPanel>
              </ScrollViewer>
            </DockPanel>
          </Border>
        </Border>

        <Border Background="#99000000" IsVisible="{Binding Dialog, Converter={x:Static ObjectConverters.IsNotNull}}"
                KeyboardNavigation.TabNavigation="Cycle">
          <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="4" Padding="28,24" Width="480"
                  HorizontalAlignment="Center" VerticalAlignment="Center" BoxShadow="0 16 48 0 #88000000">
            <StackPanel Spacing="16" DataContext="{Binding Dialog}" x:DataType="vm:DialogViewModel">
              <TextBlock Classes="heading" FontSize="24" Text="{Binding Title}" />
              <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Classes="muted" />
              <TextBox Text="{Binding Input}" IsVisible="{Binding HasInput}" Name="DialogInput" PasswordChar="{Binding InputMask}" />
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10"
                          IsVisible="{Binding ConfirmText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <Button Content="{Binding CancelText}" Command="{Binding CancelCommand}" Classes="ghost"
                        IsVisible="{Binding CancelText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" IsCancel="True" />
                <Button Name="DialogConfirm" Content="{Binding ConfirmText}" Command="{Binding ConfirmCommand}" Classes="primary" IsDefault="True"
                        Classes.danger="{Binding Danger}" />
              </StackPanel>
            </StackPanel>
          </Border>
        </Border>
      </Panel>
    </LayoutTransformControl>

  </Panel>
</Window>
