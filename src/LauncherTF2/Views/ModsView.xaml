<UserControl x:Class="LauncherTF2.Views.ModsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:LauncherTF2.ViewModels"
             xmlns:local="clr-namespace:LauncherTF2.Views"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="1030"
             Background="{DynamicResource PageBackgroundBrush}"
             AllowDrop="True"
             Drop="UserControl_Drop"
             DragEnter="UserControl_DragEnter"
             DragOver="UserControl_DragOver">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Toggle Switch -->
        <Style x:Key="ModToggleStyle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Background" Width="40" Height="20" Background="{DynamicResource SurfaceInsetBrush}" CornerRadius="10">
                            <Ellipse x:Name="Dot" Width="14" Height="14" Fill="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Left" Margin="3,0">
                                <Ellipse.RenderTransform>
                                    <TranslateTransform X="0"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Background" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Dot" Property="Fill" Value="White"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Dot" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="20" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Dot" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="0" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Filter Pill -->
        <Style x:Key="FilterPillStyle" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bg" Background="{DynamicResource SurfaceBrush}" CornerRadius="14" Padding="14,6" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush" Value="#555"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Icon Button -->
        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="8" Padding="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Delete Button -->
        <Style x:Key="DeleteButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="6" Padding="6" Width="28" Height="28">
                            <Path x:Name="Icon" Fill="{DynamicResource SecondaryTextBrush}" Width="14" Height="14" Stretch="Uniform"
                                  Data="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#3D1515"/>
                                <Setter TargetName="Icon" Property="Fill" Value="#FF5252"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Pill/secondary text button -->
        <Style x:Key="PillButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="8" Padding="14,7"
                                BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Accent (primary) button -->
        <Style x:Key="AccentButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{DynamicResource AccentBrush}" CornerRadius="8" Padding="18,8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ─── Themed right-click menu (follows the active theme brushes) ─── -->
        <Style x:Key="ThemedContextMenuStyle" TargetType="ContextMenu">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1" CornerRadius="10" Padding="6" Margin="0,0,8,8">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.45"/>
                            </Border.Effect>
                            <ItemsPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ThemedMenuItemStyle" TargetType="MenuItem">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="6" Padding="12,8">
                            <ContentPresenter ContentSource="Header" TextElement.FontSize="12"
                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                              VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ThemedMenuSeparatorStyle" TargetType="Separator">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Rectangle Height="1" Fill="{DynamicResource BorderBrush}" Margin="8,4"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ─── Card right-click menu ───
             A ContextMenu lives outside the visual tree, so AncestorType bindings
             can't reach the UserControl from inside it. The card root carries the
             ViewModel in Tag; menu items reach it via PlacementTarget.Tag.
             x:Shared="False" gives each card its own menu instance. -->
        <ContextMenu x:Key="AddonContextMenu" x:Shared="False" Style="{StaticResource ThemedContextMenuStyle}">
            <MenuItem Command="{Binding PlacementTarget.Tag.ToggleAddonCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding}">
                <MenuItem.Style>
                    <Style TargetType="MenuItem" BasedOn="{StaticResource ThemedMenuItemStyle}">
                        <Setter Property="Header" Value="Enable"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsEnabled}" Value="True">
                                <Setter Property="Header" Value="Disable"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsParticleMod}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </MenuItem.Style>
            </MenuItem>
            <MenuItem Header="Change Thumbnail..." Style="{StaticResource ThemedMenuItemStyle}"
                      Command="{Binding PlacementTarget.Tag.ChangeThumbnailCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding}"/>
            <MenuItem Header="Remove Thumbnail" Style="{StaticResource ThemedMenuItemStyle}"
                      Command="{Binding PlacementTarget.Tag.RemoveThumbnailCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding}"
                      Visibility="{Binding ThumbnailPath, Converter={StaticResource StringNotEmptyToVisibilityConverter}}"/>
            <Separator Style="{StaticResource ThemedMenuSeparatorStyle}"/>
            <MenuItem Style="{StaticResource ThemedMenuItemStyle}"
                      Command="{Binding PlacementTarget.Tag.RemoveAddonCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding}">
                <MenuItem.Header>
                    <TextBlock Text="Remove from Library" Foreground="#FF8A80"/>
                </MenuItem.Header>
            </MenuItem>
        </ContextMenu>

        <!-- ─── Grid card (PreloaderAddonModel) ─── -->
        <DataTemplate x:Key="GridAddonTemplate">
            <Border Margin="6" Background="{DynamicResource CardBrush}" CornerRadius="12" Cursor="Arrow"
                    RenderTransformOrigin="0.5,0.5"
                    Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    ContextMenu="{StaticResource AddonContextMenu}">
                <Border.RenderTransform>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Border.RenderTransform>
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.02" Duration="0:0:0.15"/>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.02" Duration="0:0:0.15"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.0" Duration="0:0:0.15"/>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.0" Duration="0:0:0.15"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="85"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Themed logo placeholder / custom thumbnail (right-click → Change Thumbnail) -->
                    <Border Grid.Row="0" CornerRadius="12,12,0,0" Background="{DynamicResource SurfaceBrush}">
                        <Grid>
                            <Image Stretch="Uniform" Opacity="0.15" Margin="20"
                                   Source="{Binding DataContext.Theme.CurrentLogoSource, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                   Visibility="{Binding ThumbnailPath, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}"/>
                            <!-- Loaded via PathToImageSourceConverter (OnLoad, no file lock)
                                 so Remove Thumbnail can delete the file while it's shown. -->
                            <Image Stretch="UniformToFill"
                                   Source="{Binding ThumbnailPath, IsAsync=True, Converter={StaticResource PathToImageSourceConverter}}"
                                   Visibility="{Binding ThumbnailPath, Converter={StaticResource StringNotEmptyToVisibilityConverter}}"/>
                        </Grid>
                    </Border>

                    <!-- Type badge -->
                    <Border Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8"
                            Background="{DynamicResource SurfaceAltBrush}" CornerRadius="8" Padding="6,3">
                        <TextBlock Text="{Binding TypeLabel}" Foreground="White" FontSize="9" FontWeight="Bold"/>
                    </Border>

                    <!-- Active dot -->
                    <Ellipse Grid.Row="0" Width="9" Height="9" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{DynamicResource SecondaryTextBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEnabled}" Value="True">
                                        <Setter Property="Fill" Value="#4CAF50"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>

                    <!-- Compatibility badge (read-only): amber = possible conflict, red = incompatible.
                         Hover for the reason. Only shown when the engine `compat` scan flagged the mod. -->
                    <Border Grid.Row="0" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="8"
                            CornerRadius="6" Padding="6,3" ToolTip="{Binding CompatMessage}"
                            Visibility="{Binding HasCompatIssue, Converter={StaticResource BoolToVis}}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#FFB300"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Compat}" Value="Incompatible">
                                        <Setter Property="Background" Value="#FF5252"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Foreground="Black" FontSize="8" FontWeight="Bold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="POSSÍVEL CONFLITO"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Compat}" Value="Incompatible">
                                            <Setter Property="Text" Value="INCOMPATÍVEL"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>

                    <!-- Content -->
                    <StackPanel Grid.Row="1" Margin="10,10,10,12">
                        <TextBlock Text="{Binding DisplayName}" Foreground="White" FontSize="13" FontWeight="Bold"
                                   TextTrimming="CharacterEllipsis" Margin="0,0,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource DeleteButtonStyle}"
                                        Command="{Binding DataContext.RemoveAddonCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" ToolTip="Remove from library"/>
                            </StackPanel>

                            <Grid Grid.Column="1" VerticalAlignment="Center">
                                <CheckBox IsChecked="{Binding IsEnabled, Mode=OneWay}" Style="{StaticResource ModToggleStyle}"
                                          Command="{Binding DataContext.ToggleAddonCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          CommandParameter="{Binding}" ToolTip="Include in the preload"
                                          Visibility="{Binding IsParticleMod, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                                <TextBlock Text="always active" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="10" FontStyle="Italic"
                                           VerticalAlignment="Center" ToolTip="Contains particles (must be active)"
                                           Visibility="{Binding IsParticleMod, Converter={StaticResource BoolToVis}}"/>
                            </Grid>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- ─── List card (PreloaderAddonModel) ─── -->
        <DataTemplate x:Key="ListAddonTemplate">
            <Border Margin="0,0,0,6" Background="{DynamicResource CardBrush}" CornerRadius="8" Padding="14"
                    Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    ContextMenu="{StaticResource AddonContextMenu}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Active dot -->
                    <Ellipse Grid.Column="0" Width="9" Height="9" VerticalAlignment="Center" Margin="2,0,12,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{DynamicResource SecondaryTextBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEnabled}" Value="True">
                                        <Setter Property="Fill" Value="#4CAF50"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding DisplayName}" Foreground="White" FontSize="14" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding TypeLabel}" Foreground="{DynamicResource AccentBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,2,0,0"/>
                    </StackPanel>

                    <!-- Compatibility badge (read-only): amber = possible conflict, red = incompatible. -->
                    <Border Grid.Column="2" VerticalAlignment="Center" Margin="0,0,12,0"
                            CornerRadius="6" Padding="7,3" ToolTip="{Binding CompatMessage}"
                            Visibility="{Binding HasCompatIssue, Converter={StaticResource BoolToVis}}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#FFB300"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Compat}" Value="Incompatible">
                                        <Setter Property="Background" Value="#FF5252"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Foreground="Black" FontSize="9" FontWeight="Bold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="POSSÍVEL CONFLITO"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Compat}" Value="Incompatible">
                                            <Setter Property="Text" Value="INCOMPATÍVEL"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>

                    <Button Grid.Column="3" Style="{StaticResource DeleteButtonStyle}"
                            Command="{Binding DataContext.RemoveAddonCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}" ToolTip="Remove from library" VerticalAlignment="Center" Margin="0,0,10,0"/>

                    <Grid Grid.Column="4" VerticalAlignment="Center">
                        <CheckBox IsChecked="{Binding IsEnabled, Mode=OneWay}" Style="{StaticResource ModToggleStyle}"
                                  Command="{Binding DataContext.ToggleAddonCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  CommandParameter="{Binding}" ToolTip="Include in the preload"
                                  Visibility="{Binding IsParticleMod, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                        <Border Background="{DynamicResource AccentBrush}" CornerRadius="6" Padding="7,3" VerticalAlignment="Center"
                                ToolTip="Mods containing custom particles are injected by the engine and are always active — delete to remove."
                                Visibility="{Binding IsParticleMod, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="PARTICLES" Foreground="White" FontSize="8" FontWeight="Bold"/>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="30,10,30,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Header -->
            <RowDefinition Height="Auto"/>  <!-- Stats + Filters -->
            <RowDefinition Height="*"/>     <!-- Library -->
            <RowDefinition Height="Auto"/>  <!-- Apply bar -->
            <RowDefinition Height="Auto"/>  <!-- Drop Panel -->
        </Grid.RowDefinitions>

        <!-- ═══ HEADER ═══ -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="Mod Library" FontSize="30" FontWeight="Black" Foreground="White"/>
                <TextBlock Text="Casual Preloader — baked into Casual matchmaking" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" Margin="2,0,0,0"/>
            </StackPanel>

            <Border Grid.Column="1" Background="{DynamicResource SurfaceBrush}" CornerRadius="20" Height="38" Padding="14,0" Margin="30,0"
                    BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}">
                <Grid>
                    <TextBlock Text="Search mods..." Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" IsHitTestVisible="False"
                               Visibility="{Binding SearchQuery, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}"/>
                    <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                             Background="Transparent" BorderThickness="0" Foreground="White"
                             VerticalContentAlignment="Center" CaretBrush="White"/>
                </Grid>
            </Border>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource IconButtonStyle}" Command="{Binding ImportCommand}" ToolTip="Import mods (.vpk, .zip, .rar, .7z)" Margin="0,0,6,0">
                    <Path Fill="{DynamicResource SecondaryTextBrush}" Width="16" Height="16" Stretch="Uniform"
                          Data="M19 13v6H5v-6H3v6c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2v-6h-2zM11 4.83V15h2V4.83l3.59 3.58L18 7l-6-6-6 6 1.41 1.41L11 4.83z"/>
                </Button>
                <Button Style="{StaticResource IconButtonStyle}" Command="{Binding OpenCustomFolderCommand}" ToolTip="Open TF2 custom folder" Margin="0,0,6,0">
                    <Path Fill="{DynamicResource SecondaryTextBrush}" Width="16" Height="16" Stretch="Uniform"
                          Data="M10 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z"/>
                </Button>
                <Button Style="{StaticResource IconButtonStyle}" Command="{Binding RefreshCommand}" ToolTip="Reload library" Margin="0,0,6,0">
                    <Path Fill="{DynamicResource SecondaryTextBrush}" Width="16" Height="16" Stretch="Uniform"
                          Data="M17.65 6.35C16.2 4.9 14.21 4 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08c-.82 2.33-3.04 4-5.65 4-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z"/>
                </Button>
                <Button Style="{StaticResource IconButtonStyle}" Command="{Binding ToggleViewModeCommand}" ToolTip="Toggle view mode">
                    <Grid>
                        <Path Fill="{DynamicResource SecondaryTextBrush}" Width="16" Height="16" Stretch="Uniform"
                              Visibility="{Binding IsGridView, Converter={StaticResource BoolToVis}}"
                              Data="M3 3h7v7H3V3zm11 0h7v7h-7V3zM3 14h7v7H3v-7zm11 0h7v7h-7v-7z"/>
                        <Path Fill="{DynamicResource SecondaryTextBrush}" Width="16" Height="16" Stretch="Uniform"
                              Visibility="{Binding IsGridView, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                              Data="M3 4h18v2H3V4zm0 6h18v2H3v-2zm0 6h18v2H3v-2z"/>
                    </Grid>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ═══ STATS + FILTERS ═══ -->
        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12">
                    <Run Text="{Binding TotalCount, Mode=OneWay}"/><Run Text=" mods"/>
                </TextBlock>
                <TextBlock Text=" • " Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12"/>
                <TextBlock Foreground="#4CAF50" FontSize="12">
                    <Run Text="{Binding ActiveCount, Mode=OneWay}"/><Run Text=" active"/>
                </TextBlock>
                <TextBlock Text=" • " Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12"/>
                <TextBlock Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12">
                    <Run Text="{Binding InactiveCount, Mode=OneWay}"/><Run Text=" inactive"/>
                </TextBlock>
                <TextBlock Text=" — " Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" Margin="8,0,0,0"/>
                <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" TextTrimming="CharacterEllipsis" MaxWidth="460"/>
            </StackPanel>

            <StackPanel Grid.Row="1" Orientation="Horizontal">
                <RadioButton Style="{StaticResource FilterPillStyle}" IsChecked="True" GroupName="ModFilter"
                             Command="{Binding ChangeFilterCommand}" CommandParameter="All">
                    <TextBlock Foreground="White" FontSize="12" FontWeight="SemiBold"><Run Text="All"/><Run Text=" · "/><Run Text="{Binding TotalCount, Mode=OneWay}"/></TextBlock>
                </RadioButton>
                <RadioButton Style="{StaticResource FilterPillStyle}" GroupName="ModFilter"
                             Command="{Binding ChangeFilterCommand}" CommandParameter="Active">
                    <TextBlock Foreground="White" FontSize="12" FontWeight="SemiBold"><Run Text="Active"/><Run Text=" · "/><Run Text="{Binding ActiveCount, Mode=OneWay}"/></TextBlock>
                </RadioButton>
                <RadioButton Style="{StaticResource FilterPillStyle}" GroupName="ModFilter"
                             Command="{Binding ChangeFilterCommand}" CommandParameter="Inactive">
                    <TextBlock Foreground="White" FontSize="12" FontWeight="SemiBold"><Run Text="Inactive"/><Run Text=" · "/><Run Text="{Binding InactiveCount, Mode=OneWay}"/></TextBlock>
                </RadioButton>
                <RadioButton Style="{StaticResource FilterPillStyle}" GroupName="ModFilter"
                             Command="{Binding ChangeFilterCommand}" CommandParameter="Particles"
                             ToolTip="Mods that contain custom particles — the engine injects these whole and they are always active">
                    <TextBlock Foreground="White" FontSize="12" FontWeight="SemiBold"><Run Text="Particles"/><Run Text=" · "/><Run Text="{Binding ParticleCount, Mode=OneWay}"/></TextBlock>
                </RadioButton>
            </StackPanel>
        </Grid>

        <!-- ═══ LIBRARY ═══ -->
        <Grid Grid.Row="2">
            <ScrollViewer Style="{StaticResource ModernScrollViewerStyle}"
                          HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <Grid>
                    <ItemsControl ItemsSource="{Binding FilteredView}"
                                  ItemTemplate="{StaticResource GridAddonTemplate}"
                                  Visibility="{Binding IsGridView, Converter={StaticResource BoolToVis}}"
                                  VerticalAlignment="Top">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="5" VerticalAlignment="Top"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <ItemsControl ItemsSource="{Binding FilteredView}"
                                  ItemTemplate="{StaticResource ListAddonTemplate}"
                                  Visibility="{Binding IsGridView, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <!-- Empty state (engine available, no mods) -->
                    <Border Background="{DynamicResource SurfaceInsetBrush}" CornerRadius="16" Padding="40,50" Margin="8">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsPreloaderAvailable}" Value="True"/>
                                            <Condition Binding="{Binding FilteredView.IsEmpty}" Value="True"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel HorizontalAlignment="Center">
                            <Path Fill="{DynamicResource SecondaryTextBrush}" Width="48" Height="48" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,16"
                                  Data="M19 13v6H5v-6H3v6c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2v-6h-2zM11 4.83V15h2V4.83l3.59 3.58L18 7l-6-6-6 6 1.41 1.41L11 4.83z"/>
                            <TextBlock Text="No mods in the preloader library" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="18" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" Margin="0,0,0,8"/>
                            <TextBlock Text="Drop VPK files, ZIP/RAR/7z archives, or folders below to import them.&#x0a;Imported mods are activated and synced into Casual matchmaking automatically."
                                       Foreground="{DynamicResource SecondaryTextBrush}" FontSize="13" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="440" Margin="0,0,0,20"/>
                            <Button Command="{Binding ImportCommand}" Style="{StaticResource PillButtonStyle}" HorizontalAlignment="Center">
                                <TextBlock Text="Import Mods" Foreground="White" FontSize="13" FontWeight="SemiBold"/>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Engine-unavailable banner -->
                    <Border Background="{DynamicResource SurfaceInsetBrush}" CornerRadius="16" Padding="40,50" Margin="8"
                            Visibility="{Binding IsPreloaderUnavailable, Converter={StaticResource BoolToVis}}">
                        <StackPanel HorizontalAlignment="Center">
                            <Path Fill="#FF8A80" Width="44" Height="44" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,16"
                                  Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"/>
                            <TextBlock Text="Python 3.10+ is required" Foreground="White" FontSize="18" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" Margin="0,0,0,8"/>
                            <TextBlock Text="The Mod Preloader requires Python to run. Please install Python 3.10 or newer (ensure 'Add Python to PATH' is checked during installation) and restart the launcher."
                                       Foreground="{DynamicResource SecondaryTextBrush}" FontSize="13" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="460" Margin="0,0,0,20"/>
                            <Button Command="{Binding DownloadPythonCommand}" Style="{StaticResource PillButtonStyle}" HorizontalAlignment="Center" Margin="0,0,0,16">
                                <TextBlock Text="Download Python" Foreground="White" FontSize="13" FontWeight="SemiBold"/>
                            </Button>
                            <TextBlock Text="{Binding EngineDescription}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="460"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </ScrollViewer>
        </Grid>

        <!-- ═══ SYNC BAR (Instant Readiness — auto-bakes; no manual Apply) ═══ -->
        <Border Grid.Row="3" Margin="0,10,0,0" Background="{DynamicResource CardBrush}" CornerRadius="12" Padding="16,12"
                Visibility="{Binding IsPreloaderAvailable, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Sync status dot: green synced · amber synced-with-warnings · accent baking · red blocked.
                         Later triggers win, so baking/blocked override the warning colour. -->
                    <Ellipse Grid.Column="0" Width="9" Height="9" VerticalAlignment="Center" Margin="0,0,10,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="#4CAF50"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasBakeWarnings}" Value="True">
                                        <Setter Property="Fill" Value="#FFB300"/>
                                        <Setter Property="ToolTip" Value="{Binding BakeWarningsTooltip}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsBaking}" Value="True">
                                        <Setter Property="Fill" Value="{DynamicResource AccentBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ShowSyncButton}" Value="True">
                                        <Setter Property="Fill" Value="#FF8A80"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Casual Preload" Foreground="White" FontSize="14" FontWeight="Bold"/>
                        <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11"
                                   TextTrimming="CharacterEllipsis" Margin="0,2,16,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Command="{Binding RemovePreloadCommand}" Style="{StaticResource PillButtonStyle}" Margin="0,0,8,0"
                                ToolTip="Remove all preloader content from TF2 (keeps your library)">
                            <TextBlock Text="Remove Preload" Foreground="#FF8A80" FontSize="12" FontWeight="SemiBold"/>
                        </Button>
                        <!-- Manual Sync appears only when an auto-bake couldn't run (TF2 open / failed) -->
                        <Button Command="{Binding SyncNowCommand}" Style="{StaticResource AccentButtonStyle}"
                                ToolTip="Sync your mod changes into the game now"
                                Visibility="{Binding ShowSyncButton, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Sync" Foreground="White" FontSize="13" FontWeight="SemiBold"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <ProgressBar Height="3" Margin="0,10,0,0" Minimum="0" Maximum="100"
                             Value="{Binding Percent, Mode=OneWay}"
                             Visibility="{Binding IsWorking, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
        </Border>

        <!-- ═══ DROP PANEL (Collapsible) ═══ -->
        <Grid Grid.Row="4" Margin="0,8,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Button Grid.Row="0" HorizontalAlignment="Center"
                    Command="{Binding ToggleDropPanelCommand}" Background="Transparent" BorderThickness="0"
                    Cursor="Hand" ToolTip="Toggle import panel" Width="60" Height="20">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="4">
                            <Path x:Name="ArrowPath" Fill="{DynamicResource SecondaryTextBrush}" Width="14" Height="8" Stretch="Uniform"
                                  RenderTransformOrigin="0.5,0.5" Data="M7 10l5 5 5-5z">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Setter Property="RenderTransform">
                                            <Setter.Value>
                                                <RotateTransform Angle="0"/>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDropPanelExpanded}" Value="False">
                                                <Setter Property="RenderTransform">
                                                    <Setter.Value>
                                                        <RotateTransform Angle="180"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ArrowPath" Property="Fill" Value="#888"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <Border Grid.Row="1" x:Name="DropZone" CornerRadius="12" MinHeight="110"
                    AllowDrop="True" Drop="DropZone_Drop" DragEnter="DropZone_DragEnter" DragLeave="DropZone_DragLeave" DragOver="DropZone_DragOver"
                    Background="{DynamicResource SurfaceInsetBrush}" BorderThickness="2" BorderBrush="{DynamicResource BorderBrush}"
                    Visibility="{Binding IsDropPanelExpanded, Converter={StaticResource BoolToVis}}">
                <Grid Margin="20,14">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding IsBusy, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,6">
                            <Path Fill="{DynamicResource SecondaryTextBrush}" Width="20" Height="20" Stretch="Uniform" Margin="0,0,8,0"
                                  Data="M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z"/>
                            <TextBlock Text="Drop mod files here to import into the preloader" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="Supports .vpk, .zip, .rar, .7z files and folders"
                                   Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                        <ProgressBar IsIndeterminate="True" Width="200" Height="3" Margin="0,0,0,10"/>
                        <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="13" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
