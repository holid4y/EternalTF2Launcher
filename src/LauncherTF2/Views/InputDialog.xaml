<Window x:Class="LauncherTF2.Views.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Input" Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent"
        KeyDown="Window_KeyDown" ResizeMode="NoResize"
        ShowInTaskbar="False">

    <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="14"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="30" ShadowDepth="0" Opacity="0.7"/>
        </Border.Effect>

        <Grid Margin="28,24,28,24" MouseLeftButtonDown="Grid_MouseLeftButtonDown">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title -->
            <TextBlock x:Name="TitleText" Grid.Row="0"
                       Foreground="{DynamicResource TextBrush}" FontSize="16" FontWeight="SemiBold"
                       FontFamily="Segoe UI" Margin="0,0,0,16"/>

            <!-- Primary prompt + input -->
            <TextBlock x:Name="PromptText" Grid.Row="1"
                       Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12"
                       FontFamily="Segoe UI" TextWrapping="Wrap" Margin="0,0,0,6"/>

            <TextBox x:Name="InputTextBox" Grid.Row="2" Height="34" Padding="10,6"
                     Background="{DynamicResource SurfaceInsetBrush}"
                     Foreground="{DynamicResource TextBrush}"
                     CaretBrush="{DynamicResource TextBrush}"
                     BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                     FontFamily="Segoe UI" FontSize="13"
                     Margin="0,0,0,14"/>

            <!-- Optional description prompt + input -->
            <TextBlock x:Name="DescriptionLabel" Grid.Row="3"
                       Text="Description (optional)"
                       Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12"
                       FontFamily="Segoe UI" Margin="0,0,0,6"/>

            <TextBox x:Name="DescriptionTextBox" Grid.Row="4" Height="60" Padding="10,6"
                     TextWrapping="Wrap" AcceptsReturn="True"
                     Background="{DynamicResource SurfaceInsetBrush}"
                     Foreground="{DynamicResource TextBrush}"
                     CaretBrush="{DynamicResource TextBrush}"
                     BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                     FontFamily="Segoe UI" FontSize="13"
                     Margin="0,0,0,0"/>

            <!-- Buttons -->
            <StackPanel Grid.Row="5" Orientation="Horizontal"
                        HorizontalAlignment="Right" Margin="0,18,0,0">

                <Button Content="Cancel" Click="CancelButton_Click"
                        Width="90" Height="34" Margin="0,0,10,0" Cursor="Hand"
                        Foreground="{DynamicResource SecondaryTextBrush}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bg" Background="{DynamicResource SurfaceAltBrush}" CornerRadius="8"
                                    BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SurfaceInsetBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <Button.FontFamily><FontFamily>Segoe UI</FontFamily></Button.FontFamily>
                    <Button.FontSize>13</Button.FontSize>
                </Button>

                <Button Content="OK" Click="OkButton_Click"
                        Width="90" Height="34" Cursor="Hand"
                        Foreground="{DynamicResource AccentForegroundBrush}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bg" Background="{DynamicResource AccentBrush}" CornerRadius="8" BorderThickness="0">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Opacity" Value="0.85"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bg" Property="Opacity" Value="0.7"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <Button.FontFamily><FontFamily>Segoe UI</FontFamily></Button.FontFamily>
                    <Button.FontSize>13</Button.FontSize>
                    <Button.FontWeight>SemiBold</Button.FontWeight>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
